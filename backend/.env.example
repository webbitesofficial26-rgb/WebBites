# Copy to .env and fill in local values. Never commit .env or real credentials.
MONGO_URI=
# Use a long, random secret; keep it private.
JWT_SECRET=
PORT=5000
FRONTEND_URL=http://localhost:3000

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=WebBites
# Used only by `node testEmail.js`
EMAIL_TEST_RECIPIENT=

# Admin provisioning (used only by `node createAdmin.js`)
ADMIN_NAME=WebBites Admin
ADMIN_EMAIL=
# At least 12 characters; do not use old example/default credentials.
ADMIN_PASSWORD=

# Razorpay: use Test Mode keys for development; never commit secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gemini API (keep this key on the backend only)
GEMINI_API_KEY=

# Gemini chat model settings (backend only). These model names can be changed if access/availability differs.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
